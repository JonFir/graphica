{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Path diagram — draft 0.1",
  "description": "Data-shape validation only; graph and execution constraints are specified in format/README.md.",
  "oneOf": [
    { "$ref": "#/$defs/decisionTree" },
    { "$ref": "#/$defs/behaviorTree" },
    { "$ref": "#/$defs/activityDiagram" }
  ],
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]*$",
      "not": { "pattern": "[\\r\\n]" }
    },
    "text": { "type": "string", "minLength": 1 },
    "diagramBase": {
      "type": "object",
      "required": ["formatVersion", "kind", "id", "title", "nodes"],
      "properties": {
        "formatVersion": { "const": "0.1" },
        "kind": { "type": "string" },
        "id": { "$ref": "#/$defs/identifier" },
        "title": { "$ref": "#/$defs/text" },
        "description": { "type": "string" },
        "nodes": { "type": "array", "minItems": 1 }
      }
    },
    "nodeBase": {
      "type": "object",
      "required": ["id", "type", "title"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "type": { "type": "string" },
        "title": { "$ref": "#/$defs/text" },
        "description": { "type": "string" }
      }
    },
    "choice": {
      "type": "object",
      "required": ["id", "label", "target"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "label": { "$ref": "#/$defs/text" },
        "target": { "$ref": "#/$defs/identifier" }
      },
      "additionalProperties": false
    },
    "question": {
      "allOf": [
        { "$ref": "#/$defs/nodeBase" },
        {
          "properties": {
            "type": { "const": "question" },
            "choices": {
              "type": "array",
              "minItems": 2,
              "items": { "$ref": "#/$defs/choice" }
            }
          },
          "required": ["choices"]
        }
      ],
      "unevaluatedProperties": false
    },
    "result": {
      "allOf": [
        { "$ref": "#/$defs/nodeBase" },
        {
          "properties": {
            "type": { "const": "result" },
            "value": { "$ref": "#/$defs/text" }
          },
          "required": ["value"]
        }
      ],
      "unevaluatedProperties": false
    },
    "decisionTree": {
      "allOf": [
        { "$ref": "#/$defs/diagramBase" },
        {
          "properties": {
            "kind": { "const": "decision-tree" },
            "root": { "$ref": "#/$defs/identifier" },
            "nodes": {
              "items": {
                "oneOf": [
                  { "$ref": "#/$defs/question" },
                  { "$ref": "#/$defs/result" }
                ]
              }
            }
          },
          "required": ["root"]
        }
      ],
      "unevaluatedProperties": false
    },
    "composite": {
      "allOf": [
        { "$ref": "#/$defs/nodeBase" },
        {
          "properties": {
            "type": { "enum": ["sequence", "selector"] },
            "children": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "$ref": "#/$defs/identifier" }
            }
          },
          "required": ["children"]
        }
      ],
      "unevaluatedProperties": false
    },
    "leaf": {
      "allOf": [
        { "$ref": "#/$defs/nodeBase" },
        { "properties": { "type": { "enum": ["action", "condition"] } } }
      ],
      "unevaluatedProperties": false
    },
    "behaviorTree": {
      "allOf": [
        { "$ref": "#/$defs/diagramBase" },
        {
          "properties": {
            "kind": { "const": "behavior-tree" },
            "root": { "$ref": "#/$defs/identifier" },
            "nodes": {
              "items": {
                "oneOf": [
                  { "$ref": "#/$defs/composite" },
                  { "$ref": "#/$defs/leaf" }
                ]
              }
            }
          },
          "required": ["root"]
        }
      ],
      "unevaluatedProperties": false
    },
    "activityNode": {
      "allOf": [
        { "$ref": "#/$defs/nodeBase" },
        {
          "properties": {
            "type": { "enum": ["initial", "action", "decision", "merge", "final"] }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "fork": {
      "allOf": [
        { "$ref": "#/$defs/nodeBase" },
        {
          "properties": {
            "type": { "const": "fork" },
            "join": { "$ref": "#/$defs/identifier" }
          },
          "required": ["join"]
        }
      ],
      "unevaluatedProperties": false
    },
    "join": {
      "allOf": [
        { "$ref": "#/$defs/nodeBase" },
        {
          "properties": {
            "type": { "const": "join" },
            "fork": { "$ref": "#/$defs/identifier" }
          },
          "required": ["fork"]
        }
      ],
      "unevaluatedProperties": false
    },
    "edge": {
      "type": "object",
      "required": ["id", "source", "target"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "source": { "$ref": "#/$defs/identifier" },
        "target": { "$ref": "#/$defs/identifier" },
        "label": { "$ref": "#/$defs/text" }
      },
      "additionalProperties": false
    },
    "activityDiagram": {
      "allOf": [
        { "$ref": "#/$defs/diagramBase" },
        {
          "properties": {
            "kind": { "const": "activity-diagram" },
            "entry": { "$ref": "#/$defs/identifier" },
            "nodes": {
              "items": {
                "oneOf": [
                  { "$ref": "#/$defs/activityNode" },
                  { "$ref": "#/$defs/fork" },
                  { "$ref": "#/$defs/join" }
                ]
              }
            },
            "edges": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/edge" }
            }
          },
          "required": ["entry", "edges"]
        }
      ],
      "unevaluatedProperties": false
    }
  }
}
